@page "/"
@using Hawkeye.App.Services
@using Hawkeye.App.Services.Windowing
@using Hawkeye.App.ViewModels
@using Hawkeye.Engine.Services.Session
@using Hawkeye.Engine.Settings
@using System.Globalization
@implements IDisposable
@inject CombatSessionManager Sessions
@inject SystemStatsService Stats
@inject ISettingsService Settings
@inject OverlayManager Overlays
@inject MeterSource Source
@inject DetailsState Details
@inject UpdateService Updates
@inject Hawkeye.Engine.Services.Pvp.PvpTracker Pvp
@inject Hawkeye.Engine.Services.Pvp.PvpHistory PvpHistory
@inject PvpView PvpView
@inject Hawkeye.Engine.Services.Arena.ArenaTracker Arena
@inject Hawkeye.Engine.Services.Theostone.TheostoneAlerts Theostones
@using Microsoft.JSInterop
@inject IJSRuntime JS

@*
    The meter. Colours live at the top of MeterPage.razor.css.
    The logo sits on the panel's top-left corner, half outside the frame (owner's reference look).
    The window is resized from invisible strips on the right and bottom edges; there is no grip.
*@
<div class="shell @vm!.LookClass @(vm.AutoHeight ? "is-auto" : "") @(vm.SideExpanded ? "side-open" : "")">
    <img class="meter-logo" src="images/hawkeye-emblem.png" alt="" draggable="false" @onmousedown="() => vm!.BeginDrag()" />

    @* History and Extras: a slim vertical strip down the left side, so the header stays uncluttered. *@
    <div class="meter-side">
        @if (vm.SideVisible > 0)
        {
            <button type="button" class="side-btn" title="History: your last 100 fights"
                    @onclick="() => vm!.OpenHistory()" @onmousedown:stopPropagation="true">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.1" /><path d="M8 4.4v3.9l2.7 1.7" /></svg>
            </button>
        }
        @if (vm.SideVisible > 1)
        {
            <button type="button" class="side-btn" title="Extras: Odyle on all your characters"
                    @onclick="() => vm!.OpenExtras()" @onmousedown:stopPropagation="true">
                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.5" width="4.5" height="4.5" /><rect x="9" y="2.5" width="4.5" height="4.5" /><rect x="2.5" y="9" width="4.5" height="4.5" /><rect x="9" y="9" width="4.5" height="4.5" /></svg>
            </button>
        }
        @if (vm.SideVisible > 2)
        {
            <button type="button" class="side-btn @(vm!.PvpButtonOn ? "is-on" : "")" title="@(vm.PvpButtonOn ? "Back to the DPS meter" : "PvP mode: kills, deaths, assists, AP and rank points; Arena tab inside")"
                    @onclick="() => vm.TogglePvp()" @onmousedown:stopPropagation="true">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 2.5l8 8M13.5 2.5l-8 8M9.5 12.5l3 -3M3.5 9.5l3 3M11 11l2.5 2.5M5 11l-2.5 2.5" /></svg>
            </button>
        }
        @if (vm.SideVisible > 3)
        {
            <button type="button" class="side-btn" title="@(vm.ArenaMode ? "Start the arena wins and losses again" : vm.PvpMode ? "Start the PvP count again" : "Clear: blank the meter until your next fight (fights are kept in History)")"
                    @onclick="() => vm!.Clear()" @onmousedown:stopPropagation="true">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.5h10M6.2 4.5V3h3.6v1.5M4.6 4.5l.7 8.5h5.4l.7-8.5" /></svg>
            </button>
        }
        @if (vm.SideFolded || vm.SideExpanded)
        {
            <button type="button" class="side-btn side-more" title="@(vm.SideExpanded ? "Fewer buttons" : "More buttons")"
                    @onclick="() => vm.ToggleSide()" @onmousedown:stopPropagation="true">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="@(vm.SideExpanded ? "M4 10l4-4 4 4" : "M4 6l4 4 4-4")" /></svg>
            </button>
        }
    </div>

    <div class="meter">
        <div class="meter-header" @onmousedown="() => vm!.BeginDrag()">
            <span class="meter-target" title="@vm!.TargetName">@vm.TargetName</span>
            @if (vm.ShowDummyButton)
            {
                <button type="button" class="meter-run @(vm.DummyRunning ? "is-running" : "")"
                        title="@(vm.DummyRunning ? "Stop the dummy run and keep its numbers" : "Clear the dummy numbers and start counting from your next hit")"
                        @onclick="() => vm.ToggleDummyRun()" @onmousedown:stopPropagation="true">@(vm.DummyRunning ? "STOP" : "START")</button>
            }
            <span class="meter-timer @(vm.ShowingHistory ? "is-last" : "")" title="@(vm.ShowingHistory ? "Your last fight (from history)" : "Fight time")">@(vm.DummyWaiting ? "ready" : vm.Duration)</span>
            <button type="button" class="meter-btn meter-btn--settings" title="Settings"
                    @onclick="() => vm.OpenSettings()" @onmousedown:stopPropagation="true">⚙</button>
            <button type="button" class="meter-btn meter-btn--close" title="Close Hawkeye"
                    @onclick="() => vm.Close()" @onmousedown:stopPropagation="true">✕</button>
        </div>

        @* Theostone procs (v0.2.17; "Scope" style since v0.2.23): over the top of the meter for a few seconds. *@
        @if (vm.Theostones.Count > 0)
        {
            <div class="theo-alerts">
                @foreach (var p in vm.Theostones)
                {
                    <div class="theo-alert @(p.Yours ? "is-yours" : "is-on-you")" @key="p.Name + p.Yours">
                        <div class="theo-ring">
                            <svg viewBox="0 0 44 44">
                                @if (p.IsDebuff) { <circle class="bg" cx="22" cy="22" r="20" /> }
                                <circle class="arc" cx="22" cy="22" r="20" stroke-dasharray="125.66" transform="rotate(-90 22 22)"
                                        stroke-dashoffset="@((125.66 * (1 - Math.Clamp(vm.ProcBar(p) < 0 ? 1 : vm.ProcBar(p) / 100, 0, 1))).ToString("0.##", CultureInfo.InvariantCulture))" />
                            </svg>
                            <img src="images/hawkeye-emblem.png" alt="" />
                        </div>
                        <div class="theo-text">
                            <span class="theo-tag">@Hawkeye.App.Views.TheostoneAlertWindow.TagText(p)</span>
                            <span class="theo-name @(p.Grade >= 0 ? $"g{p.Grade}" : "")">@p.Word</span>
                            <span class="theo-num"><b class="theo-dmg">@vm.ProcMain(p)</b>@if (p.Flags.Length > 0) { <em class="theo-flag">@p.Flags</em> }@if (Hawkeye.App.Views.TheostoneAlertWindow.SubText(p) is { Length: > 0 } extra) { <span class="theo-who">@extra</span> }</span>
                        </div>
                    </div>
                }
            </div>
        }

        @if (vm.ArenaMode)
        {
            <div class="meter-pvp meter-arena" @onmousedown="() => vm.BeginDrag()">
                <div class="pvp-tabs" @onmousedown:stopPropagation="true">
                    <button type="button" @onclick="() => vm.ShowArena(false)">World</button>
                    <button type="button" class="is-on">Arena</button>
                </div>
                @if (vm.HasArenaMatch)
                {
                    <div class="arena-score @(vm.ArenaResult == "Won" ? "is-won" : vm.ArenaResult == "Lost" ? "is-lost" : "")"
                         title="Kills this match: your team, then theirs"><b>@vm.ArenaScore</b>@if (vm.ArenaResult != "") {<span>@vm.ArenaResult</span>}</div>
                    @foreach (var f in vm.ArenaFoes)
                    {
                        <div class="arena-foe"><div class="foe-name"><span>@f.Name</span><small>@f.Rating</small></div></div>
                    }
                }
                <div class="pvp-kda">
                    <div class="is-clickable" title="Who you beat" @onclick="() => vm.OpenArenaList(Hawkeye.Engine.Services.Pvp.PvpEventKind.Kill)" @onmousedown:stopPropagation="true"><b>@vm.ArenaWins</b><span>Wins</span></div>
                    <div class="is-clickable" title="Who beat you" @onclick="() => vm.OpenArenaList(Hawkeye.Engine.Services.Pvp.PvpEventKind.Death)" @onmousedown:stopPropagation="true"><b>@vm.ArenaLosses</b><span>Losses</span></div>
                    <div><b>@vm.ArenaChange</b><span>Rating</span></div>
                </div>
                <div class="pvp-gain"><span>Arena rating</span><b>@vm.ArenaRating</b></div>
            </div>
        }
        else if (vm.PvpMode)
        {
            <div class="meter-pvp" @onmousedown="() => vm.BeginDrag()">
                <div class="pvp-tabs" @onmousedown:stopPropagation="true">
                    <button type="button" class="is-on">World</button>
                    <button type="button" @onclick="() => vm.ShowArena(true)">Arena</button>
                </div>
                <div class="pvp-kda">
                    <div class="is-clickable" title="Who you killed" @onclick="() => vm.OpenPvpList(Hawkeye.Engine.Services.Pvp.PvpEventKind.Kill)" @onmousedown:stopPropagation="true"><b>@vm.Kills</b><span>Kills</span></div>
                    <div class="is-clickable" title="Who killed you" @onclick="() => vm.OpenPvpList(Hawkeye.Engine.Services.Pvp.PvpEventKind.Death)" @onmousedown:stopPropagation="true"><b>@vm.Deaths</b><span>Deaths</span></div>
                    <div class="is-clickable" title="Kills you helped with" @onclick="() => vm.OpenPvpList(Hawkeye.Engine.Services.Pvp.PvpEventKind.Assist)" @onmousedown:stopPropagation="true"><b>@vm.Assists</b><span>Assists</span></div>
                </div>
                <div class="pvp-gain"><span>AP</span><b>@vm.ApGained</b></div>
                <div class="pvp-gain"><span>Rank points</span><b>@vm.RankGained</b></div>
                <div class="pvp-rank @vm.RankClass" title="@vm.Rank.Tip"><span>@vm.Rank.Left</span><b>@vm.Rank.Right</b></div>
                <button type="button" class="pvp-end" title="Save this session to PvP history and start a new one"
                        @onclick="() => vm.EndPvpSession()" @onmousedown:stopPropagation="true">End session</button>
            </div>
        }
        else
        {
        <div class="meter-rows" style="@(vm.AutoHeight ? $"height:{vm.RowsHeightPx}px" : "")" @onmousedown="() => vm.BeginDrag()">
            @foreach (var p in vm.Players)
            {
                <div class="meter-row @(p.IsUser ? "is-me" : "")" title="@p.Detail"
                     @onmousedown="RowDown" @onmousedown:stopPropagation="true"
                     @onmousemove="RowMove" @onclick="() => vm.OpenDetails(p.PlayerId)">
                    <div class="meter-fill" style="width:@(Math.Clamp(p.BarPercent, 0, 100).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                    <div class="meter-icon" style="background-image:url('images/classes/@(p.ClassId).png')"></div>
                    <span class="meter-name">@p.Name</span>
                    <span class="meter-cp">@(vm.ShowCombatPower ? p.Cp : "")</span>
                    @if (vm.ShowDeaths && p.Deaths > 0)
                    {
                        <span class="meter-deaths" title="Died @(p.Deaths)x on this boss">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M8 1.6c-3.3 0-5.9 2.4-5.9 5.6 0 1.9.9 3.4 2.4 4.2v2.4h7v-2.4c1.5-.8 2.4-2.3 2.4-4.2 0-3.2-2.6-5.6-5.9-5.6zM5.6 9.5a1.45 1.45 0 1 0 0-2.9 1.45 1.45 0 0 0 0 2.9zm4.8 0a1.45 1.45 0 1 0 0-2.9 1.45 1.45 0 0 0 0 2.9z" /></svg>@p.Deaths
                        </span>
                    }
                    @if (vm.ShowTotals)
                    {
                        <span class="meter-total">@p.Total</span>
                    }
                    <span class="meter-dps">@(p.Dps)<small>/s</small></span>
                </div>
            }
        </div>
        }

        @* Status line at the bottom, with the version at its end so it always sits inside the frame. *@
            <div class="meter-status" @onmousedown="() => vm.BeginDrag()">
                @foreach (var item in vm.StatusItems)
                {
                    @if (item.Clickable)
                    {
                        <span class="@item.Css is-clickable" title="@item.Title"
                              @onclick="() => vm.OnStatusClick(item)" @onmousedown:stopPropagation="true">@item.Text</span>
                    }
                    else
                    {
                        <span class="@item.Css" title="@item.Title">@item.Text</span>
                    }
                }
                <span class="status-version" title="Hawkeye @Branding.Version">@Branding.Version</span>
            </div>
    </div>

    <div class="resize resize--right" @onmousedown="@(() => vm!.BeginResize("right"))"></div>
    @if (!vm.AutoHeight)
    {
        @* With "fit height to group" on, the height is automatic: only the width can be dragged. *@
        <div class="resize resize--bottom" @onmousedown="@(() => vm!.BeginResize("bottom"))"></div>
        <div class="resize resize--corner" @onmousedown="@(() => vm!.BeginResize("corner"))"></div>
    }
</div>

@code {
    private MeterViewModel? vm;

    protected override void OnInitialized() =>
        vm = new MeterViewModel(Sessions, Stats, Settings, Overlays, Source, Details, Updates, Pvp, PvpHistory, PvpView, Theostones, Arena, () => InvokeAsync(StateHasChanged));

    // A row is clicked for its breakdown, but holding the button and moving still drags the meter.
    private double downX, downY;
    private bool rowPressed;

    private void RowDown(MouseEventArgs e)
    {
        downX = e.ScreenX;
        downY = e.ScreenY;
        rowPressed = e.Button == 0;
    }

    private void RowMove(MouseEventArgs e)
    {
        if (!rowPressed || (e.Buttons & 1) == 0) { rowPressed = false; return; }
        if (Math.Abs(e.ScreenX - downX) + Math.Abs(e.ScreenY - downY) < 4) return;
        rowPressed = false;
        vm!.BeginDrag();
    }

    private string measuredKey = string.Empty;

    /// <summary>"Fit height to group": after any layout change, measure the content and size the window to it.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (vm is null) return;
        await MeasureSideAsync();
        if (!vm.AutoHeight) { measuredKey = string.Empty; return; }
        var key = $"{vm.FitRows}|{vm.StatusItems.Count}|{vm.TargetName}|{vm.ShowDummyButton}|{vm.LookClass}|{vm.PvpMode}|{vm.ArenaMode}|{vm.ArenaFoes.Count}|{vm.HasArenaMatch}|{vm.SideExpanded}";
        if (key == measuredKey) return;
        measuredKey = key;
        try
        {
            var height = await JS.InvokeAsync<double>("hawkeyeMeasure");
            vm.ApplyMeasuredHeight(height);
        }
        catch (Exception) { measuredKey = string.Empty; /* page closing; try again next render */ }
    }

    /// <summary>Folds the side strip when the window is too short for all its buttons; unfolded, grows the window to fit.</summary>
    private async Task MeasureSideAsync()
    {
        try
        {
            if (vm!.SideExpanded && !vm.AutoHeight)
            {
                vm.GrowTo(await JS.InvokeAsync<double>("hawkeyeSideNeed"));
                return;
            }
            var slots = await JS.InvokeAsync<int>("hawkeyeSideSlots");
            if (slots != vm.SideSlots)
            {
                vm.SideSlots = slots;
                StateHasChanged();
            }
        }
        catch (Exception) { /* page closing */ }
    }

    public void Dispose() => vm?.Dispose();
}
