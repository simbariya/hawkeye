@page "/history"
@using System.Globalization
@using Hawkeye.App.Services
@using Hawkeye.App.Services.Windowing
@using Hawkeye.Engine.Services.History
@implements IDisposable
@inject IEncounterHistory History
@inject DetailsState Details
@inject OverlayManager Overlays
@inject Hawkeye.Engine.Settings.ISettingsService Settings
@inject Hawkeye.Engine.Services.Pvp.PvpHistory PvpHistory
@inject Hawkeye.Engine.Services.Arena.ArenaHistory ArenaHistory
@inject PvpView PvpView
@inject CompareState Compare

@*
    Fight history: kept-forever fights first, then the last 100 fights you took part in (oldest drop off).
    PvP tab: Select ticks sessions to delete together (owner 2026-11-22: clear the test sessions).
    Arena tab (v0.2.42): every finished arena match, saved as it ends, so the stats survive updates and restarts.
    Click a fight for its combat analysis. Fights tab: Compare ticks fights to put side by side (v0.2.34).
*@
<div class="hh @Hawkeye.App.Services.Looks.ClassFor(Settings.Current.Look)">
    <header class="hh-header" @onmousedown="() => Overlays.DragPage(typeof(HistoryPage))">
        <span class="hh-title">HISTORY</span>
        @foreach (var (t, label) in new[] { (Tab.Fights, "Fights"), (Tab.Pvp, "PvP"), (Tab.Arena, "Arena") })
        {
            <button type="button" class="hh-tab @(tab == t ? "is-on" : "")" @onclick="() => Pick(t)" @onmousedown:stopPropagation="true">@label</button>
        }
        <span class="hh-spacer"></span>
        @if (tab == Tab.Fights && recent.Count + saved.Count >= 2)
        {
            <button type="button" class="hh-tool @(comparing ? "is-on" : "")" title="Tick fights to compare them side by side, with your skill levels"
                    @onclick="ToggleCompare" @onmousedown:stopPropagation="true">@(comparing ? "Cancel" : "Compare")</button>
        }
        @if ((tab == Tab.Pvp && pvpSessions.Count > 0) || (tab == Tab.Arena && arena.Count > 0))
        {
            <button type="button" class="hh-tool @(selecting ? "is-on" : "")" title="@(tab == Tab.Arena ? "Tick matches to delete several at once" : "Tick sessions to delete several at once")"
                    @onclick="ToggleSelect" @onmousedown:stopPropagation="true">@(selecting ? "Done" : "Select")</button>
        }
        <button type="button" class="hh-close" title="Close" @onclick="() => Overlays.ClosePage(typeof(HistoryPage))" @onmousedown:stopPropagation="true">✕</button>
    </header>

    @if (tab == Tab.Arena)
    {
        var today = arena.Where(r => r.At.Date == DateTime.Today).ToList();
        <div class="hh-sum">
            <span title="Every arena match saved here">All <b class="is-win">@arena.Count(r => r.Won) W</b> <b class="is-loss">@arena.Count(r => !r.Won) L</b> @Rate(arena)</span>
            <span title="Matches played today">Today <b class="is-win">@today.Count(r => r.Won) W</b> <b class="is-loss">@today.Count(r => !r.Won) L</b> @Signed(today.Sum(r => r.RatingChange))</span>
            @if (arena.FirstOrDefault() is { RatingAfter: > 0 } last)
            {
                <span title="Your rating after your last match (@last.Mode)">Rating <b>@last.RatingAfter.ToString("N0", CultureInfo.InvariantCulture)</b></span>
            }
        </div>
        <div class="hh-body">
            @if (arena.Count == 0)
            {
                <div class="hh-empty">No arena matches yet. Every arena match you finish is saved here by itself.</div>
            }
            @foreach (var r in arena)
            {
                bool ticked = picked.Contains(r.Id);
                <div class="hh-row hh-arena @(selecting ? "is-selecting" : "") @(ticked ? "is-picked" : "")"
                     @onclick="() => ArenaClick(r)" title="@(selecting ? "Tick to delete" : r.Character)">
                    @if (selecting)
                    {
                        <span class="hh-tick">@(ticked ? "✓" : "")</span>
                    }
                    <span class="hh-when">@r.At.ToString("dd MMM HH:mm", CultureInfo.InvariantCulture)</span>
                    <span class="hh-result @(r.Won ? "is-win" : "is-loss")">@(r.Won ? "Win" : "Loss")</span>
                    <span class="hh-foes">
                        @foreach (var f in r.Opponents)
                        {
                            var link = Hawkeye.Engine.Services.Pvp.ShugoLinks.ForArena(f.Name, f.Server);
                            var server = Hawkeye.Engine.Services.Pvp.ShugoLinks.Code(f.Server);
                            <span class="hh-foe" title="@($"{f.Name}  {f.ClassName}  rating {f.Rating}  {server}".Trim())">
                                <span class="hh-class" style="@(f.ClassId != 0 ? $"background-image:url('images/classes/{f.ClassId}.png')" : "")"></span>
                                @if (link is not null && !selecting)
                                {
                                    <span class="is-link" title="Open @f.Name's profile" @onclick="() => Overlays.OpenProfile(link, f.Name)" @onclick:stopPropagation="true">@f.Name</span>
                                }
                                else
                                {
                                    <span>@(string.IsNullOrEmpty(f.Name) ? "Unknown" : f.Name)</span>
                                }
                            </span>
                        }
                    </span>
                    <span class="hh-dur" title="Arena mode">@r.Mode</span>
                    <span class="hh-dur" title="Score">@r.OurKills-@r.TheirKills</span>
                    <span class="hh-gain" title="Your rating after the match, and the change">@(r.RatingAfter > 0 ? r.RatingAfter.ToString(CultureInfo.InvariantCulture) : "") @(r.RatingBefore is null ? "" : Signed(r.RatingChange))</span>
                    <button type="button" class="hh-del" title="Delete this match"
                            @onclick="() => ArenaHistory.Delete([r.Id])" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        </div>
        @if (selecting)
        {
            <div class="hh-bar">
                <button type="button" class="hh-tool" @onclick="PickAll">@(picked.Count == arena.Count ? "Tick none" : "Tick all")</button>
                <span class="hh-spacer"></span>
                <button type="button" class="hh-tool is-danger" disabled="@(picked.Count == 0)" @onclick="DeletePicked">
                    Delete @picked.Count @(picked.Count == 1 ? "match" : "matches")
                </button>
            </div>
        }
    }
    else if (tab == Tab.Pvp)
    {
        <div class="hh-body">
            @if (pvpSessions.Count == 0)
            {
                <div class="hh-empty">No PvP sessions yet. Press End session in PvP mode to save one here.</div>
            }
            @foreach (var s in pvpSessions)
            {
                bool ticked = picked.Contains(s.Id);
                <div class="hh-row hh-pvp @(selecting ? "is-selecting" : "") @(ticked ? "is-picked" : "")"
                     @onclick="() => RowClick(s)" title="@(selecting ? "Tick to delete" : "See who you killed, died to and helped with")">
                    @if (selecting)
                    {
                        <span class="hh-tick">@(ticked ? "✓" : "")</span>
                    }
                    <span class="hh-when">@s.StartedAt.ToString("dd MMM HH:mm", CultureInfo.InvariantCulture)</span>
                    <span class="hh-target" title="@s.Character">@s.Character</span>
                    <span class="hh-dur">@Dur(s.Duration)</span>
                    <span class="hh-kda" title="Kills / deaths / assists">@s.Kills / @s.Deaths / @s.Assists</span>
                    <span class="hh-gain" title="AP gained">@Signed(s.Ap) AP</span>
                    <span class="hh-gain" title="Rank points gained">@Signed(s.Rank) RP</span>
                    <button type="button" class="hh-del" title="Delete this session"
                            @onclick="() => PvpHistory.Delete(s.Id)" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        </div>
        @if (selecting)
        {
            <div class="hh-bar">
                <button type="button" class="hh-tool" @onclick="PickAll">@(picked.Count == pvpSessions.Count ? "Tick none" : "Tick all")</button>
                <span class="hh-spacer"></span>
                <button type="button" class="hh-tool is-danger" disabled="@(picked.Count == 0)" @onclick="DeletePicked">
                    Delete @picked.Count @(picked.Count == 1 ? "session" : "sessions")
                </button>
            </div>
        }
    }
    else
    {
    <div class="hh-body">
        @if (saved.Count > 0)
        {
            <div class="hh-section">KEPT FOREVER</div>
            @foreach (var e in saved)
            {
                <div class="hh-row @(comparing && toCompare.Contains(e.Id) ? "is-compared" : "")" @onclick="() => FightClick(e)"
                     title="@(comparing ? "Tick to compare" : "Open the combat analysis")">
                    @if (comparing)
                    {
                        <span class="hh-tick">@(toCompare.Contains(e.Id) ? "✓" : "")</span>
                    }
                    else
                    {
                        <span class="hh-star is-on">★</span>
                    }
                    @Line(e)
                    <button type="button" class="hh-del" title="Remove from kept-forever"
                            @onclick="() => History.DeleteSaved(e.Id)" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        }

        <div class="hh-section">RECENT</div>
        @if (recent.Count == 0)
        {
            <div class="hh-empty">No fights yet. Every boss or dummy fight you take part in lands here when it ends.</div>
        }
        @foreach (var e in recent)
        {
            bool kept = e.IsSaved || saved.Any(s => s.Id == e.Id);
            <div class="hh-row @(comparing && toCompare.Contains(e.Id) ? "is-compared" : "")" @onclick="() => FightClick(e)"
                 title="@(comparing ? "Tick to compare" : "Open the combat analysis")">
                @if (comparing)
                {
                    <span class="hh-tick">@(toCompare.Contains(e.Id) ? "✓" : "")</span>
                }
                else
                {
                    <button type="button" class="hh-star @(kept ? "is-on" : "")" title="@(kept ? "Kept forever" : "Keep this fight forever")"
                            @onclick="() => History.KeepForever(e.Id)" @onclick:stopPropagation="true">@(kept ? "★" : "☆")</button>
                }
                @Line(e)
            </div>
        }
    </div>
    @if (comparing)
    {
        <div class="hh-bar">
            <span class="hh-hint">@(toCompare.Count < 2 ? "Tick two or more fights" : $"{toCompare.Count} fights ticked")</span>
            <span class="hh-spacer"></span>
            <button type="button" class="hh-tool" disabled="@(toCompare.Count == 0)" @onclick="() => toCompare.Clear()">Tick none</button>
            <button type="button" class="hh-tool is-go" disabled="@(toCompare.Count < 2)" @onclick="OpenCompare">Compare @toCompare.Count</button>
        </div>
    }
    }
    <ResizeEdges Page="typeof(HistoryPage)" />
</div>

@code {
    private List<EncounterSnapshot> recent = new();
    private List<EncounterSnapshot> saved = new();
    private List<Hawkeye.Engine.Services.Pvp.PvpSession> pvpSessions = new();
    private List<Hawkeye.Engine.Services.Arena.ArenaRecord> arena = new();
    private enum Tab { Fights, Pvp, Arena }
    private Tab tab;

    private void Pick(Tab t)
    {
        if (tab == t) return;
        tab = t;
        selecting = comparing = false;
        picked.Clear();
        toCompare.Clear();
    }

    private void ArenaClick(Hawkeye.Engine.Services.Arena.ArenaRecord r)
    {
        if (!selecting) return;
        if (!picked.Remove(r.Id)) picked.Add(r.Id);
    }

    private static string Rate(IReadOnlyCollection<Hawkeye.Engine.Services.Arena.ArenaRecord> list) =>
        list.Count == 0 ? "" : $"{100.0 * list.Count(r => r.Won) / list.Count:0}%";

    protected override void OnInitialized()
    {
        Load();
        History.Changed += OnChanged;
        Settings.Changed += OnChanged;
        PvpHistory.Changed += OnChanged;
        ArenaHistory.Changed += OnChanged;
    }

    private void Load()
    {
        recent = History.Recent.ToList();
        saved = History.Saved.ToList();
        pvpSessions = PvpHistory.Sessions.ToList();
        arena = ArenaHistory.Records.ToList();
        picked.IntersectWith(tab == Tab.Arena ? arena.Select(r => r.Id) : pvpSessions.Select(s => s.Id));
        toCompare.IntersectWith(recent.Select(e => e.Id).Concat(saved.Select(e => e.Id)));
        if ((tab == Tab.Arena ? arena.Count : pvpSessions.Count) == 0) selecting = false;
    }

    private bool selecting;
    private readonly HashSet<Guid> picked = new();

    private bool comparing;
    private readonly HashSet<Guid> toCompare = new();

    private void ToggleCompare()
    {
        comparing = !comparing;
        toCompare.Clear();
    }

    private void FightClick(EncounterSnapshot e)
    {
        if (!comparing) { Open(e); return; }
        if (!toCompare.Remove(e.Id)) toCompare.Add(e.Id);
    }

    private void OpenCompare()
    {
        var all = saved.Concat(recent).Where(e => toCompare.Contains(e.Id)).DistinctBy(e => e.Id).ToList();
        if (all.Count < 2) return;
        Compare.Show(all);
        Overlays.OpenCompare();
        comparing = false;
        toCompare.Clear();
    }

    private void ToggleSelect()
    {
        selecting = !selecting;
        picked.Clear();
    }

    private void RowClick(Hawkeye.Engine.Services.Pvp.PvpSession s)
    {
        if (!selecting) { OpenPvp(s); return; }
        if (!picked.Remove(s.Id)) picked.Add(s.Id);
    }

    private void PickAll()
    {
        var all = tab == Tab.Arena ? arena.Select(r => r.Id).ToList() : pvpSessions.Select(s => s.Id).ToList();
        if (picked.Count == all.Count) picked.Clear();
        else foreach (var id in all) picked.Add(id);
    }

    private void DeletePicked()
    {
        if (picked.Count == 0) return;
        if (tab == Tab.Arena) ArenaHistory.Delete(picked.ToList());
        else PvpHistory.Delete(picked.ToList());
        picked.Clear();
        selecting = false;
    }

    private void OpenPvp(Hawkeye.Engine.Services.Pvp.PvpSession s)
    {
        PvpView.ShowSaved(s);
        Overlays.OpenPvp();
    }

    private static string Dur(TimeSpan d) => d.TotalHours >= 1 ? d.ToString(@"h\:mm\:ss") : d.ToString(@"mm\:ss");
    private static string Signed(long v) => (v > 0 ? "+" : "") + Short(v);

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(() => { Load(); StateHasChanged(); });

    private void Open(EncounterSnapshot e)
    {
        Details.ShowSaved(e);
        Overlays.OpenDetails();
    }

    private RenderFragment Line(EncounterSnapshot e) => __builder =>
    {
        var you = e.You;
        var top = e.Players.FirstOrDefault();
        <span class="hh-when">@e.StartedAt.ToString("dd MMM HH:mm", CultureInfo.InvariantCulture)</span>
        <span class="hh-target" title="@e.TargetName">@e.TargetName</span>
        <span class="hh-dur">@TimeSpan.FromSeconds(e.DurationSeconds).ToString(@"mm\:ss")</span>
        <span class="hh-dps" title="@(you is not null ? "Your DPS" : "Top DPS")">@Short(you?.Dps ?? top?.Dps ?? 0)/s</span>
        <span class="hh-count" title="Players">@e.Players.Count</span>
    };

    private static string Short(double v) => Hawkeye.App.ViewModels.MeterViewModel.Compact((long)Math.Round(v), shortThousands: true);

    public void Dispose()
    {
        History.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
        PvpHistory.Changed -= OnChanged;
        ArenaHistory.Changed -= OnChanged;
    }
}
