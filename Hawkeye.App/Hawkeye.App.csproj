<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <AssemblyName>Hawkeye</AssemblyName>
    <RootNamespace>Hawkeye.App</RootNamespace>
    <Product>Hawkeye</Product>
    <Version>0.2.19</Version>
    <ApplicationIcon>hawkeye.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The updater fetches the full zip for self-contained builds, the small one otherwise. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);SELF_CONTAINED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.23" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hawkeye.Core\Hawkeye.Core.csproj" />
    <ProjectReference Include="..\Hawkeye.Engine\Hawkeye.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="hawkeye.ico" />
  </ItemGroup>

  <!-- Streamer mode serves these from inside the exe (Services/Streaming/StreamServer.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="hawkeye-web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
